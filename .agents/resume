#!/usr/bin/env bash
# Runs each time an orb starts or wakes. Gives Nix the thread's GitHub token, so flake fetches
# aren't rate-limited, the way home/nix.nix does it on the machines. Docs: docs/orbs.md.
set -euo pipefail

tokens_file="$HOME/.config/nix/access-tokens.conf"

token=${GH_TOKEN:-$(gh auth token 2>/dev/null || true)}
if [ -z "$token" ]; then
  echo "No GitHub token; Nix fetches from GitHub without one" >&2
  rm -f "$tokens_file"
  exit 0
fi

mkdir -p "$(dirname "$tokens_file")"
tmp=$(mktemp "$tokens_file.XXXXXX") # mktemp creates it 0600
printf 'access-tokens = github.com=%s\n' "$token" > "$tmp"
mv "$tmp" "$tokens_file"
