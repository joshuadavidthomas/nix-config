{
  "restart": {
    "policy": "always"
  },
  "containers": [
    {
      "name": "prepare",
      "image": "busybox:1.37",
      "cmd": [
        "sh",
        "-c",
        "mkdir -p /data/tailscale /data/vm /data/vl /data/grafana /data/alertmanager /data/hark /data/logs && chown 472:0 /data/grafana && chown 65534:65534 /data/alertmanager"
      ],
      "restart": {
        "policy": "no"
      }
    },
    {
      "name": "tailscale",
      "image": "tailscale/tailscale:v1.102.5",
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "cmd": [
        "TS_AUTHKEY=\"${TS_AUTHKEY}?ephemeral=false&preauthorized=true\" exec /usr/local/bin/containerboot"
      ],
      "env": {
        "TS_HOSTNAME": "monitor",
        "TS_EXTRA_ARGS": "--advertise-tags=tag:monitor",
        "TS_STATE_DIR": "/data/tailscale",
        "TS_USERSPACE": "false",
        "TS_AUTH_ONCE": "true",
        "TS_SERVE_CONFIG": "/etc/tailscale/serve.json"
      },
      "secrets": [
        {
          "env_var": "TS_AUTHKEY"
        }
      ],
      "files": [
        {
          "guest_path": "/etc/tailscale/serve.json",
          "local_path": "tailscale/serve.json"
        }
      ],
      "depends_on": [
        {
          "name": "prepare",
          "condition": "exited_successfully"
        }
      ],
      "restart": {
        "policy": "always"
      }
    },
    {
      "name": "victoriametrics",
      "image": "victoriametrics/victoria-metrics:v1.154.0",
      "cmd": [
        "-storageDataPath=/data/vm",
        "-retentionPeriod=1y",
        "-httpListenAddr=:8428",
        "-enableTCP6",
        "-vmalert.proxyURL=http://127.0.0.1:8880",
        "-search.latencyOffset=5s",
        "-promscrape.config=/etc/victoriametrics/scrape.yml"
      ],
      "depends_on": [
        {
          "name": "prepare",
          "condition": "exited_successfully"
        }
      ],
      "healthchecks": [
        {
          "name": "http",
          "kind": "liveness",
          "http": {
            "port": 8428,
            "path": "/health",
            "scheme": "http",
            "method": "GET"
          },
          "interval": 15,
          "timeout": 5,
          "grace_period": 10,
          "failure_threshold": 3,
          "success_threshold": 1
        }
      ],
      "restart": {
        "policy": "always"
      },
      "files": [
        {
          "guest_path": "/etc/victoriametrics/scrape.yml",
          "local_path": "victoriametrics/scrape.yml"
        }
      ],
      "secrets": [
        {
          "env_var": "FLY_LOG_TOKEN"
        }
      ]
    },
    {
      "name": "victorialogs",
      "image": "victoriametrics/victoria-logs:v1.53.0",
      "cmd": [
        "-storageDataPath=/data/vl",
        "-retentionPeriod=30d",
        "-httpListenAddr=:9428",
        "-enableTCP6"
      ],
      "depends_on": [
        {
          "name": "prepare",
          "condition": "exited_successfully"
        }
      ],
      "healthchecks": [
        {
          "name": "http",
          "kind": "liveness",
          "http": {
            "port": 9428,
            "path": "/health",
            "scheme": "http",
            "method": "GET"
          },
          "interval": 15,
          "timeout": 5,
          "grace_period": 10,
          "failure_threshold": 3,
          "success_threshold": 1
        }
      ],
      "restart": {
        "policy": "always"
      }
    },
    {
      "name": "vmalert",
      "image": "victoriametrics/vmalert:v1.154.0",
      "cmd": [
        "-rule=/etc/vmalert/rules.yml",
        "-datasource.url=http://127.0.0.1:8428",
        "-remoteWrite.url=http://127.0.0.1:8428",
        "-remoteRead.url=http://127.0.0.1:8428",
        "-notifier.url=http://127.0.0.1:9093",
        "-httpListenAddr=127.0.0.1:8880",
        "-evaluationInterval=30s"
      ],
      "files": [
        {
          "guest_path": "/etc/vmalert/rules.yml",
          "local_path": "vmalert/rules.yml"
        }
      ],
      "depends_on": [
        {
          "name": "victoriametrics",
          "condition": "healthy"
        },
        {
          "name": "alertmanager",
          "condition": "healthy"
        }
      ],
      "healthchecks": [
        {
          "name": "http",
          "kind": "liveness",
          "http": {
            "port": 8880,
            "path": "/health",
            "scheme": "http",
            "method": "GET"
          },
          "interval": 15,
          "timeout": 5,
          "grace_period": 10,
          "failure_threshold": 3,
          "success_threshold": 1
        }
      ],
      "restart": {
        "policy": "always"
      }
    },
    {
      "name": "alertmanager",
      "image": "prom/alertmanager:v0.34.1",
      "cmd": [
        "--config.file=/etc/alertmanager/alertmanager.yml",
        "--storage.path=/data/alertmanager",
        "--web.listen-address=127.0.0.1:9093",
        "--cluster.listen-address="
      ],
      "files": [
        {
          "guest_path": "/etc/alertmanager/alertmanager.yml",
          "local_path": "alertmanager/alertmanager.yml"
        }
      ],
      "depends_on": [
        {
          "name": "prepare",
          "condition": "exited_successfully"
        }
      ],
      "healthchecks": [
        {
          "name": "http",
          "kind": "liveness",
          "http": {
            "port": 9093,
            "path": "/-/healthy",
            "scheme": "http",
            "method": "GET"
          },
          "interval": 15,
          "timeout": 5,
          "grace_period": 10,
          "failure_threshold": 3,
          "success_threshold": 1
        }
      ],
      "restart": {
        "policy": "always"
      }
    },
    {
      "name": "hark",
      "image": "python:3.13-alpine",
      "cmd": [
        "python3",
        "/app/relay.py"
      ],
      "env": {
        "HARK_APP_ID": "app_jtxjHf9n2_zQS3ag",
        "HEARTBEAT_URL": "https://homelab-heartbeat.joshthomasdev.workers.dev/ping",
        "HARK_ONCALL_GROUP": "ocg_r281ZmraVfmAQQVW"
      },
      "secrets": [
        {
          "env_var": "HARK_WEBHOOK_URL"
        },
        {
          "env_var": "HEARTBEAT_TOKEN"
        },
        {
          "env_var": "HARK_PAGES_TOKEN"
        }
      ],
      "files": [
        {
          "guest_path": "/app/relay.py",
          "local_path": "hark/relay.py"
        }
      ],
      "depends_on": [
        {
          "name": "prepare",
          "condition": "exited_successfully"
        }
      ],
      "healthchecks": [
        {
          "name": "http",
          "kind": "liveness",
          "http": {
            "port": 9099,
            "path": "/health",
            "scheme": "http",
            "method": "GET"
          },
          "interval": 15,
          "timeout": 5,
          "grace_period": 10,
          "failure_threshold": 3,
          "success_threshold": 1
        }
      ],
      "restart": {
        "policy": "always"
      }
    },
    {
      "name": "logs",
      "image": "python:3.13-alpine",
      "cmd": [
        "python3",
        "-u",
        "/app/poll.py"
      ],
      "secrets": [
        {
          "env_var": "FLY_LOG_TOKEN"
        }
      ],
      "files": [
        {
          "guest_path": "/app/poll.py",
          "local_path": "logs/poll.py"
        }
      ],
      "depends_on": [
        {
          "name": "victorialogs",
          "condition": "healthy"
        }
      ],
      "restart": {
        "policy": "always"
      }
    },
    {
      "name": "grafana",
      "image": "grafana/grafana-oss:13.0.2",
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "cmd": [
        "GF_PATHS_DATA=/data/grafana exec /run.sh"
      ],
      "env": {
        "GF_PLUGINS_PREINSTALL_SYNC": "victoriametrics-logs-datasource",
        "GF_ANALYTICS_REPORTING_ENABLED": "false",
        "GF_SERVER_ROOT_URL": "https://monitor.tail014d2.ts.net/",
        "GF_SERVER_HTTP_ADDR": "127.0.0.1",
        "GF_SECURITY_COOKIE_SECURE": "true",
        "GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH": "/etc/grafana/dashboards/overview.json",
        "GF_LOG_LEVEL": "warn"
      },
      "files": [
        {
          "guest_path": "/etc/grafana/provisioning/datasources/monitor.yaml",
          "local_path": "grafana/datasources.yaml"
        },
        {
          "guest_path": "/etc/grafana/provisioning/dashboards/monitor.yaml",
          "local_path": "grafana/dashboards.yaml"
        },
        {
          "guest_path": "/etc/grafana/dashboards/overview.json",
          "local_path": "grafana/dashboards/overview.json"
        },
        {
          "guest_path": "/etc/grafana/dashboards/capacity.json",
          "local_path": "grafana/dashboards/capacity.json"
        },
        {
          "guest_path": "/etc/grafana/dashboards/vms.json",
          "local_path": "grafana/dashboards/vms.json"
        },
        {
          "guest_path": "/etc/grafana/dashboards/box.json",
          "local_path": "grafana/dashboards/box.json"
        },
        {
          "guest_path": "/etc/grafana/dashboards/logs.json",
          "local_path": "grafana/dashboards/logs.json"
        },
        {
          "guest_path": "/etc/grafana/dashboards/monitor.json",
          "local_path": "grafana/dashboards/monitor.json"
        },
        {
          "guest_path": "/etc/grafana/dashboards/node-exporter-full.json",
          "local_path": "grafana/dashboards/node-exporter-full.json"
        }
      ],
      "depends_on": [
        {
          "name": "prepare",
          "condition": "exited_successfully"
        }
      ],
      "healthchecks": [
        {
          "name": "http",
          "kind": "liveness",
          "http": {
            "port": 3000,
            "path": "/api/health",
            "scheme": "http",
            "method": "GET"
          },
          "interval": 15,
          "timeout": 5,
          "grace_period": 60,
          "failure_threshold": 3,
          "success_threshold": 1
        }
      ],
      "restart": {
        "policy": "always"
      }
    }
  ]
}
