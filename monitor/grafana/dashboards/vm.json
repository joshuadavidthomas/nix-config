  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "homelab"
  ],
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "This machine",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/box/machine?var-instance=$instance",
      "keepTime": true
    }
  ],
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(yonder_build_info{job=\"yonder\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(yonder_build_info{job=\"yonder\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "vm",
        "label": "VM",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "query_result(max by (machine, name) (yonder_machine_info{job=\"yonder\", instance=\"$instance\"}))",
          "refId": "vm"
        },
        "definition": "query_result(max by (machine, name) (yonder_machine_info{job=\"yonder\", instance=\"$instance\"}))",
        "refresh": 2,
        "sort": 1,
        "regex": "/machine=\"(?<value>[^\"]+)\",name=\"(?<text>[^\"]+)\"/",
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
