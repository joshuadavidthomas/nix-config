    {
      "type": "bargauge",
      "title": "Reserved of what the host admits",
      "description": "What the host's machines and volumes reserve (yonder_host_reserved_*) as a share of what it admits: its capacity after headroom and overcommit (yonder_host_admissible_*). A create that does not fit is refused, never overcommitted.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(yonder_host_reserved_cpus{instance=\"$instance\"}) / max(yonder_host_admissible_cpus{instance=\"$instance\"})",
          "legendFormat": "CPUs",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(yonder_host_reserved_memory_bytes{instance=\"$instance\"}) / max(yonder_host_admissible_memory_bytes{instance=\"$instance\"})",
          "legendFormat": "Memory",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(yonder_host_reserved_disk_bytes{instance=\"$instance\"}) / max(yonder_host_admissible_disk_bytes{instance=\"$instance\"})",
          "legendFormat": "Disk",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto"
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Operations",
      "description": "Operations finished per minute, by kind and status (yonder_operations_total). A failed one is the operation's own result; the host's ledger is unchanged by it.",
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (kind, status) (rate(yonder_operations_total{instance=\"$instance\"}[$__rate_interval])) * 60 > 0",
          "legendFormat": "{{kind}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Operation time",
      "description": "How long operations took on average, from submission to their end, by kind (yonder_operation_seconds).",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 7
