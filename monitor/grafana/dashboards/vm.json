        "x": 8,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (state) (yonder_machines{instance=\"$instance\"}) > 0",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ],
