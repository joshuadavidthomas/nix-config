      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - vm_free_disk_space_bytes{job=\"victoriametrics\"} / vm_total_disk_space_bytes{job=\"victoriametrics\"})",
