  "panels": [
    {
      "type": "stat",
      "title": "Heartbeat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - max(tlast_change_over_time(alertmanager_notifications_total{job=\"alertmanager\", integration=\"webhook\"}[15m]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#FF9830",
                "value": 150
              },
              {
                "color": "#F2495C",
                "value": 300
              }
            ]
          },
          "mappings": [],
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "How long ago Alertmanager last sent to the relay; mostly the Watchdog's pings toward the heartbeat Worker, about once a minute. At 5 minutes the Worker pages you.",
      "id": 1
    },
