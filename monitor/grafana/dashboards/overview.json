      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "description": "Alerts: firing now, each has reached your phone. Boxes reporting: sent data in the last 3 minutes. The rest is summed over all boxes: active yonder VMs, idle cores, available memory, free space on /.",
      "id": 1
