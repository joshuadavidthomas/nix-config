              "instance": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4
            },
            "renameByName": {
              "vm": "VM",
              "instance": "Box",
              "Value #B": "Started",
              "Value #C": "Sent",
              "Value #D": "Received"
            }
          }
        }
