    {
      "type": "stat",
      "title": "$instance",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "lag(node_load1{job=\"node\", instance=\"$instance\"}[24h])",
          "legendFormat": "Reporting",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\", mode=\"idle\", instance=\"$instance\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"node\", instance=\"$instance\"} / node_memory_MemTotal_bytes{job=\"node\", instance=\"$instance\"})",
          "legendFormat": "Memory",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node\", mountpoint=\"/\", instance=\"$instance\"} / node_filesystem_size_bytes{job=\"node\", mountpoint=\"/\", instance=\"$instance\"})",
          "legendFormat": "Disk",
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(node_hwmon_temp_celsius{job=\"node\", chip=~\"platform_coretemp.*\", instance=\"$instance\"})",
          "legendFormat": "CPU temp",
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count(node_systemd_unit_state{job=\"node\", state=\"active\", name=~\"yonder-vm-.*\", instance=\"$instance\"} == 1) or vector(0)",
          "legendFormat": "VMs",
          "refId": "F"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "time() - node_boot_time_seconds{job=\"node\", instance=\"$instance\"}",
          "legendFormat": "Up",
          "refId": "G"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
