      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node\"})",
          "legendFormat": "{{instance}}"
