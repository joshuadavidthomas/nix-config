{
  "uid": "overview",
  "title": "Homelab",
  "description": "",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "homelab"
  ],
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Machine",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": {
          "query": "label_values(node_boot_time_seconds{job=\"node\"}, instance)",
          "refId": "v"
        },
        "definition": "label_values(node_boot_time_seconds{job=\"node\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": [],
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "name": "Alerts",
        "iconColor": "#F2495C",
        "expr": "max by (instance, alertname) (max_over_time(ALERTS{alertstate=\"firing\", alertname!=\"Watchdog\", instance=~\"$instance\"}[2m]))",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{instance}}",
        "tagKeys": "instance",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "victorialogs"
        },
        "enable": true,
        "name": "Deploys",
        "iconColor": "#5794F2",
        "target": {
          "refId": "Anno",
          "queryType": "instant",
          "maxLines": 1000,
          "expr": "\"finished switching to system configuration\" host:~\"^${instance:regex}$\" | format \"Deployed: <host>\" as _msg | fields _time, _msg"
        },
        "mappings": {
          "text": {
            "source": "field",
            "value": "Line"
          }
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "name": "Reboots",
        "iconColor": "#B877D9",
        "expr": "min by (instance) (time() - node_boot_time_seconds{job=\"node\", instance=~\"$instance\"}) < 300",
        "step": "60s",
        "titleFormat": "Rebooted",
        "textFormat": "{{instance}}",
        "tagKeys": "instance",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "enable": true,
        "name": "Out of memory",
        "iconColor": "#FF9830",
        "expr": "sum by (instance) (increase(node_vmstat_oom_kill{job=\"node\", instance=~\"$instance\"}[2m])) > 0",
        "step": "60s",
        "titleFormat": "Out of memory: a process was killed",
        "textFormat": "{{instance}}",
        "tagKeys": "instance",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Machines",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node\", instance=~\"$instance\", mode=\"idle\"}[$__rate_interval]))))",
          "legendFormat": "",
          "refId": "A",
          "format": "time_series"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "ceil(max by (instance) (lag(node_load1{job=\"node\", instance=~\"$instance\"}[24h])))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (100 * (1 - node_memory_MemAvailable_bytes{job=\"node\", instance=~\"$instance\"} / node_memory_MemTotal_bytes{job=\"node\", instance=~\"$instance\"}))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (100 * (1 - node_filesystem_avail_bytes{job=\"node\", instance=~\"$instance\", mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node\", instance=~\"$instance\", mountpoint=\"/\"}))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node\", instance=~\"$instance\", chip=~\"platform_coretemp.*\"})",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "count by (instance) (node_systemd_unit_state{job=\"node\", instance=~\"$instance\", state=\"active\", name=~\"yonder-vm-.*\"} == 1)",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (time() - node_boot_time_seconds{job=\"node\", instance=~\"$instance\"})",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance, model) (label_replace(label_replace(node_dmi_info{job=\"node\", instance=~\"$instance\"}, \"model\", \"$1\", \"product_name\", \"(.+)\"), \"model\", \"$1\", \"product_version\", \"(.*[a-z].*)\"))",
          "legendFormat": "",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (instance) (node_systemd_unit_state{job=\"node\", instance=~\"$instance\", state=\"failed\"})",
          "legendFormat": "",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance) (tailscaled_health_messages{job=\"tailscale\", instance=~\"$instance\", type=\"warning\"}) or (max by (instance) (node_boot_time_seconds{job=\"node\", instance=~\"$instance\"}) * 0 - 1)",
          "legendFormat": "",
          "refId": "J",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
