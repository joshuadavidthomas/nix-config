        "query": {
          "query": "label_values(node_boot_time_seconds{job=\"node\"}, instance)",
          "refId": "v"
        },
        "definition": "label_values(node_boot_time_seconds{job=\"node\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "regex": "",
        "options": [],
