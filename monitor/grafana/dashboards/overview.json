        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Receive above the line, send below, on the boxes' own NICs (not Tailscale, not yonder's VMs)."
    },
    {
