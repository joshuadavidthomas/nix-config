    {
      "id": 10,
      "type": "timeseries",
      "title": "Network (physical interfaces)",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{job=\"node\", device=~\"en.*|eth.*|wl.*\"}[$__rate_interval])) * 8",
          "legendFormat": "{{instance}} in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (instance) (rate(node_network_transmit_bytes_total{job=\"node\", device=~\"en.*|eth.*|wl.*\"}[$__rate_interval])) * -8",
          "legendFormat": "{{instance}} out"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "gradientMode": "opacity"
          },
          "color": {
            "mode": "palette-classic"
