    {
      "type": "table",
      "title": "VMs",
      "gridPos": {
        "x": 10,
        "y": 11,
        "w": 14,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance, device, vm) (label_replace(label_replace(node_systemd_unit_state{job=\"node\", state=\"active\", name=~\"yonder-vm-.*\"} == 1, \"vm\", \"$1\", \"name\", \"yonder-vm-(.*)\\\\.service\"), \"device\", \"yt-$1\", \"name\", \"yonder-vm-.*(.{12})\\\\.service\"))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance, device) (label_replace(node_systemd_unit_start_time_seconds{job=\"node\", name=~\"yonder-vm-.*\"} * 1000, \"device\", \"yt-$1\", \"name\", \"yonder-vm-.*(.{12})\\\\.service\"))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance, device) (rate(node_network_receive_bytes_total{job=\"node\", device=~\"yt-.*\"}[5m])) * 8",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (instance, device) (rate(node_network_transmit_bytes_total{job=\"node\", device=~\"yt-.*\"}[5m])) * 8",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "vm",
                "config": {
                  "id": "isNotNull",
                  "options": {}
                }
              }
            ],
            "type": "include",
            "match": "all"
          }
        },
        {
